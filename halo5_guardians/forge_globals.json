          "type": "real_bounds",
          "name": "min-max grab distance mult#auto-zoom brings you no closer/farther than multiplier x object.boundingRadius from grabbed object"
        },
        {
          "type": "real_bounds",
          "name": "minimum grab distance threshold#auto-zoom near can never leave these bounds"
        },
