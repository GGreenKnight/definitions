        },
        {
          "type": "short_integer",
          "name": "sprite spacing#number of pixels between adjacent sprites (0 uses default, negative numbers set no spacing)"
        },
        {
          "type": "pad",
          "name": "pad_spsp",
          "definition": 2
        },
        {
          "type": "real",
          "name": "bump map height:repeats#the apparent height of the bump map above the triangle it is textured onto, in texture repeats (i.e., 1.0 would be as high as the texture is wide)"
        },
        {
          "type": "real_fraction",
          "name": "fade factor:[0,1]#used by detail maps and illum maps.  0 means fade by last mipmap, 1 means fade by first mipmap"
        },
        {
          "type": "real",
          "name": "blur:pixels#how much to blur the input image"
        },
        {
          "type": "real",
          "name": "mip map blur:pixels#how much to blur as each mip level is being downsampled"
        },
        {
          "type": "real",
          "name": "specular power bias#Adjusts sharpness of resulting cubemap"
        },
        {
          "type": "real",
          "name": "base MIP bias:degrees#Zero indicates that 512x512 is our infinite-detail MIP"
        },
        {
          "type": "char_enum",
          "name": "curve mode#automatic chooses FAST if your bitmap is bright, and PRETTY if your bitmap has dark bits",
          "definition": "bitmap_struct_definition_1_options_14"
        },
        {
          "type": "char_integer",
          "name": "max mipmap level#0 = use default defined by usage"
        },
        {
          "type": "short_integer",
          "name": "max resolution#0 = do not downsample source image"
        },
        {
          "type": "short_integer",
          "name": "atlas#index into global atlas if the texture is missing its required resources and has been atlased"
        },
        {
          "type": "short_enum",
          "name": "force bitmap format#overrides the format defined by usage",
          "definition": "bitmap_struct_definition_1_options_18"
        },
        {
          "type": "real",
          "name": "tight bounds threshold:[0.0 - 1.0]#This is the level cutoff for tight bounds.  0.0 is monochrome black, 1.0 is monochrome white"
        },
